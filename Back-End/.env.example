# ============================
# FinTrack Back-End Environment
# ============================

# Database (Supabase PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# JWT Secret - gunakan string random panjang minimal 32 karakter
JWT_SECRET="your-super-secret-jwt-key-change-this"

# Google OAuth (opsional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# Frontend URL
FRONTEND_URL="http://localhost:5173"

# Vercel Blob Storage (untuk upload avatar)
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"

# Email SMTP (opsional, untuk reset password)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER="your-email@gmail.com"
MAIL_PASS="your-app-password"
MAIL_FROM="FinTrack <noreply@fintrack.app>"

# Server
PORT=5000
NODE_ENV="development"
